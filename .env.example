# 复制本文件为 .env 并填入真实值
# 真实 .env 已被 .gitignore 排除，不会推到 GitHub

# 快手开放平台
KS_APP_ID=
KS_APP_SECRET=
KS_REDIRECT_URI=https://kuaishou.ssaitool.cn/api/kuaishou/oauth/callback

# 数据库
DATABASE_URL=postgres://ssai_app:CHANGEME@127.0.0.1:5432/ssai

# JWT 签发
JWT_SECRET=

# AES-GCM Token 加密密钥（base64，32 字节）
TOKEN_ENC_KEY=

# 服务监听
BIND_ADDR=127.0.0.1:8080
PG_MAX_CONN=10
RUST_LOG=ssai_server=info,tower_http=warn,sqlx=warn
LOG_FORMAT=pretty

# Kuaishou API base
KS_BASE_URL=https://ad.e.kuaishou.com/rest/openapi

# 单租户 bootstrap admin
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_PASSWORD=
